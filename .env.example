# Copy to .env for local development; every variable is optional.

# SQLAlchemy async URL. Docker Compose sets a postgresql+asyncpg:// URL instead.
CACHE_SERVICE_DATABASE_URL=sqlite+aiosqlite:///./data/cache.db

# Simulated latency of the external transformer, so cache hits are visible.
CACHE_SERVICE_TRANSFORMER_LATENCY_SECONDS=0.5

# Per-call timeout; exceeding it counts as a transformer failure.
CACHE_SERVICE_TRANSFORMER_TIMEOUT_SECONDS=5.0

# Process-wide cap on parallel transformer calls.
CACHE_SERVICE_TRANSFORMER_MAX_CONCURRENCY=10

# Log level for the service's own loggers; third-party loggers keep their defaults.
CACHE_SERVICE_LOG_LEVEL=INFO
